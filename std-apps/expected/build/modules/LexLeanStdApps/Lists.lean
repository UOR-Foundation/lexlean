@[expose] public def oneIf (same : Bool) : Nat := (if same then 1 else 0)

@[expose] public def sumBy : (weight : ((Nat) -> (Nat))) -> (items : List (Nat)) -> Nat
  | _weight, List.nil => 0
  | weight, List.cons head rest => ((weight (head)) + sumBy (weight) (rest))

@[expose] public def countOf : (item : Nat) -> (items : List (Nat)) -> Nat
  | _item, List.nil => 0
  | item, List.cons head rest => (oneIf ((Nat.beq (head) (item))) + countOf (item) (rest))

@[expose] public def removedOne : (item : Nat) -> (items : List (Nat)) -> Nat
  | _item, List.nil => 0
  | item, List.cons head rest => (if (Nat.beq (head) (item)) then 1 else removedOne (item) (rest))

@[expose] public def keepUnless (same : Bool) (head : Nat) (rest : List (Nat)) (kept : List (Nat)) : List (Nat) := (match same with | Bool.true => rest | Bool.false => (head :: kept))

@[expose] public def removeFirst : (item : Nat) -> (items : List (Nat)) -> List (Nat)
  | _item, List.nil => ([] : List (Nat))
  | item, List.cons head rest => keepUnless ((Nat.beq (head) (item))) (head) (rest) (removeFirst (item) (rest))

@[expose] public def appendItems : (items : List (Nat)) -> (more : List (Nat)) -> List (Nat)
  | List.nil, more => more
  | List.cons head rest, more => (head :: appendItems (rest) (more))

@[expose] public def pushIf (allowed : Bool) (item : Nat) (items : List (Nat)) : List (Nat) := (match allowed with | Bool.true => (item :: items) | Bool.false => items)

