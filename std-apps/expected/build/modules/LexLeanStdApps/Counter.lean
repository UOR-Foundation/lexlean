@[expose] public def bump (cap : Nat) (count : Nat) : Nat := (if (Nat.blt (count) (cap)) then (count + 1) else count)

@[expose] public def bumpBy (cap : Nat) (step : Nat) (count : Nat) : Nat := (if (Nat.ble ((count + step)) (cap)) then (count + step) else cap)

@[expose] public def dropOne (count : Nat) : Nat := (LexLeanRuntime.subtract (count) (1) : Nat)

@[expose] public def shortfall (need : Nat) («have» : Nat) : Nat := (LexLeanRuntime.subtract (need) («have») : Nat)

@[expose] public def excess (value : Nat) (limit : Nat) : Nat := (LexLeanRuntime.subtract (value) (limit) : Nat)

