public import LexLeanRuntime.Portable
public import LexLeanRuntime.Laws
set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
set_option linter.constructorNameAsVariable false
namespace LexLeanStdApps.Lines

@[expose] public def total : (lines : List ((Prod (Nat) (Nat)))) -> Nat
  | List.nil => 0
  | List.cons head rest => ((head).2 + total (rest))

@[expose] public def amountOf : (item : Nat) -> (lines : List ((Prod (Nat) (Nat)))) -> Nat
  | _item, List.nil => 0
  | item, List.cons head rest => (if (Nat.beq ((head).1) (item)) then (head).2 else amountOf (item) (rest))

@[expose] public def countOf : (item : Nat) -> (lines : List ((Prod (Nat) (Nat)))) -> Nat
  | _item, List.nil => 0
  | item, List.cons head rest => ((if (Nat.beq ((head).1) (item)) then 1 else 0) + countOf (item) (rest))

@[expose] public def removedCount : (item : Nat) -> (lines : List ((Prod (Nat) (Nat)))) -> Nat
  | _item, List.nil => 0
  | item, List.cons head rest => (if (Nat.beq ((head).1) (item)) then 1 else removedCount (item) (rest))

@[expose] public def keepLine (same : Bool) (head : (Prod (Nat) (Nat))) (rest : List ((Prod (Nat) (Nat)))) (kept : List ((Prod (Nat) (Nat)))) : List ((Prod (Nat) (Nat))) := (match same with | Bool.true => rest | Bool.false => (head :: kept))

@[expose] public def removeLine : (item : Nat) -> (lines : List ((Prod (Nat) (Nat)))) -> List ((Prod (Nat) (Nat)))
  | _item, List.nil => ([] : List ((Prod (Nat) (Nat))))
  | item, List.cons head rest => keepLine ((Nat.beq ((head).1) (item))) (head) (rest) (removeLine (item) (rest))

@[expose] public def addLine (item : Nat) (amount : Nat) (lines : List ((Prod (Nat) (Nat)))) : List ((Prod (Nat) (Nat))) := ((item, amount) :: lines)

@[expose] public def addIf (allowed : Bool) (item : Nat) (amount : Nat) (lines : List ((Prod (Nat) (Nat)))) : List ((Prod (Nat) (Nat))) := (match allowed with | Bool.true => ((item, amount) :: lines) | Bool.false => lines)

@[expose] public def removeIf (allowed : Bool) (item : Nat) (lines : List ((Prod (Nat) (Nat)))) : List ((Prod (Nat) (Nat))) := (match allowed with | Bool.true => removeLine (item) (lines) | Bool.false => lines)

@[expose] public def removedAmount (allowed : Bool) (item : Nat) (lines : List ((Prod (Nat) (Nat)))) : Nat := (match allowed with | Bool.true => amountOf (item) (lines) | Bool.false => 0)

